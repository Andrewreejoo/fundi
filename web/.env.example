# Where the website's server reaches the API (internal URL is fine, e.g. http://api:3000 in Docker)
API_URL=http://localhost:3000
# Public URL of the API, used for photo URLs in the browser
PUBLIC_API_URL=http://localhost:3000
# Set to your public site URL in production (needed by the Node adapter for form actions)
ORIGIN=http://localhost:4173
