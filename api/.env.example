# --- Server ---
PORT=3000
NODE_ENV=development
# Public base URL of this API (used to build file URLs and the PayChangu webhook URL you register)
PUBLIC_API_URL=http://localhost:3000
# Comma-separated origins allowed to call the API from a browser (the website calls it server-side, so this is mainly for tools)
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16 with PostGIS 3) ---
DATABASE_URL=postgres://fundi:fundi@localhost:5432/fundi

# --- Auth ---
# Generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Phone numbers (any format) that get the admin role when they sign in
ADMIN_PHONES=0999000001
# Development only: return the OTP code in the API response. NEVER true in production.
DEV_OTP_ECHO=false

# --- SMS ---
# log = print messages to the console; africastalking = send real SMS
SMS_DRIVER=log
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# sandbox: https://api.sandbox.africastalking.com  live: https://api.africastalking.com
AT_BASE_URL=https://api.sandbox.africastalking.com

# --- Payments ---
# paychangu = real PayChangu API (use TEST keys for sandbox); fake = simulated, for automated tests only
PAYMENTS_DRIVER=paychangu
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_BASE_URL=https://api.paychangu.com
# Marketplace economics (whole MWK; percentages as numbers)
# Reservation deposit = DEPOSIT_PERCENT of the price, clamped to [DEPOSIT_MIN_MWK, DEPOSIT_MAX_MWK]
DEPOSIT_PERCENT=5
DEPOSIT_MIN_MWK=50000
DEPOSIT_MAX_MWK=500000
# Fee on a completed sale (taken from the deposit, never more than the deposit)
SALE_FEE_PERCENT=1
# Commission on each rental
RENTAL_COMMISSION_PERCENT=10

# --- Timers ---
PAY_WINDOW_MINUTES=30
RESERVATION_HOLD_HOURS=72
AUTO_COMPLETE_HOURS=48
DISPUTE_SLA_HOURS=72

# Public demo: seeds demo dealers and cars, simulates payments, shows sign-in codes on screen
DEMO_MODE=false

# --- Files ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
